# =============================================================================
# Obei Workflow SDK Starter 配置模板
# 复制为 .env 后填写真实值；不要提交 .env，也不要把密钥写入业务代码。
# =============================================================================

# 【必填】工作流事务数据库。保存七张核心表、任务系统 Outbox 和 LLM 审计表。
# 密码中的 @、%、: 等保留字符必须进行 URL 编码。
WORKFLOW_DATABASE_URL=mysql+pymysql://workflow:change-me@mysql:3306/workflow?charset=utf8mb4

# 【必填】ARQ 队列与分布式 Run Lock 使用的 Redis。
REDIS_URL=redis://redis:6379/0
# 【可选】实时事件/流式 token 使用的 Redis；为空时自动回退到 REDIS_URL。
EVENT_BUS_URL=
# 【可选】外部系统访问本 Starter 的基础地址；跨机器部署时不能使用 127.0.0.1。
WORKFLOW_PUBLIC_BASE_URL=http://127.0.0.1:8090

# Run Lock 租约与续期间隔。必须满足 0 < RENEW < TTL。
WORKFLOW_RUN_LOCK_TTL_SECONDS=90
WORKFLOW_RUN_LOCK_RENEW_SECONDS=30
# ARQ 单个 Job 超时与两类 Worker 并发数/队列名。
ARQ_JOB_TIMEOUT_SECONDS=600
ARQ_WORKFLOW_QUEUE=workflow
ARQ_EXECUTION_SYNC_QUEUE=execution_sync
ARQ_WORKFLOW_MAX_JOBS=4
ARQ_EXECUTION_SYNC_MAX_JOBS=2

# Redis Stream 名称前缀、近似最大长度与 SSE 阻塞读取时长。
EVENT_STREAM_PREFIX=workflow
EVENT_STREAM_MAXLEN=20000
EVENT_STREAM_BLOCK_MS=10000

# =============================================================================
# 外部任务执行系统
# Starter 默认启用并要求真实凭据。纯代码宿主可显式设为 false；关闭后仅跳过
# 外部任务绑定，本地工作流、七张核心表、事件和 LLM 审计仍会正常运行。
# =============================================================================
EXECUTION_TASK_ENABLED=true
EXECUTION_TASK_API_BASE_URL=https://your-task-system.example.com/ai-task
EXECUTION_TASK_API_KEY=change-me
EXECUTION_TASK_CALLER_ID=obei-workflow-sdk-starter
# RecordOnly 表示本地执行、远端只记录事实；具体值需遵循任务系统契约。
EXECUTION_TASK_EXECUTION_MODE=RecordOnly
EXECUTION_TASK_TIMEOUT_SECONDS=10
# 可重试错误为网络异常、HTTP 429 和 5xx；退避为 base * 2^n，并受 max 限制。
EXECUTION_TASK_RETRY_MAX_ATTEMPTS=8
EXECUTION_TASK_RETRY_BASE_SECONDS=1
EXECUTION_TASK_RETRY_MAX_SECONDS=300
# 仅向任务系统发送节点摘要。完整模型输入输出在 LLM 审计表中，不走该字段。
EXECUTION_TASK_OUTPUT_MAX_BYTES=8192

# =============================================================================
# OpenAI-compatible Chat Completions Adapter
# API Key 为空时不注册 openai Adapter；使用它的节点会明确报“未配置”。
# =============================================================================
OPENAI_BASE_URL=https://your-model-gateway.example.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=your-model-name
OPENAI_TIMEOUT_SECONDS=120

# =============================================================================
# Dify 多 App Registry。每个 Key 对应一个发布 App；JSON 只引用密钥变量名。
# app_type: chat / agent-chat / agent / advanced-chat / completion / workflow
# =============================================================================
DIFY_APPS_JSON=[{"name":"analysis_agent","base_url":"https://your-dify.example.com/v1","app_type":"agent","api_key_env":"DIFY_ANALYSIS_AGENT_KEY"},{"name":"report_workflow","base_url":"https://your-dify.example.com/v1","app_type":"workflow","api_key_env":"DIFY_REPORT_WORKFLOW_KEY"}]
DIFY_ANALYSIS_AGENT_KEY=
DIFY_REPORT_WORKFLOW_KEY=
DIFY_CONVERSATION_LOCK_TTL_SECONDS=180
DIFY_CONVERSATION_LOCK_RENEW_SECONDS=30
DIFY_CONVERSATION_LOCK_WAIT_SECONDS=180
# 单 App 旧配置仍兼容；使用 DIFY_APPS_JSON 时下面字段留空。
DIFY_BASE_URL=https://your-dify.example.com/v1
DIFY_CHAT_API_KEY=
DIFY_DEFAULT_APP_NAME=dify-chat-app
DIFY_DEFAULT_APP_TYPE=chat
DIFY_TIMEOUT_SECONDS=120
# Dify 用 user 隔离最终用户的数据、文件和会话。
DIFY_USER=obei-workflow-sdk-starter
